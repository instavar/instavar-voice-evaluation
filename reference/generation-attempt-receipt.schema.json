{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/instavar/instavar-voice-evaluation/main/reference/generation-attempt-receipt.schema.json",
  "title": "Instavar Voice generation attempt receipt",
  "type": "object",
  "required": [
    "schema_version",
    "generation_plan_sha256",
    "producer",
    "attempts",
    "evidence_boundary"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "generation_plan_sha256": { "$ref": "#/$defs/sha256" },
    "producer": { "$ref": "#/$defs/producer" },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/attempt" }
    },
    "evidence_boundary": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "producer": {
      "type": "object",
      "required": ["name", "revision"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "runtime_metrics": {
      "type": "object",
      "required": ["generation_seconds"],
      "properties": {
        "generation_seconds": { "type": "number", "minimum": 0 },
        "audio_duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "peak_memory_bytes": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "required": [
        "sample_id",
        "generation_plan_sha256",
        "planned_sample_sha256",
        "source_generation_observation_sha256",
        "output_audio_sha256",
        "runtime_metrics",
        "producer",
        "attempt_sha256"
      ],
      "properties": {
        "sample_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "generation_plan_sha256": { "$ref": "#/$defs/sha256" },
        "planned_sample_sha256": { "$ref": "#/$defs/sha256" },
        "source_generation_observation_sha256": { "$ref": "#/$defs/sha256" },
        "output_audio_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "runtime_metrics": { "$ref": "#/$defs/runtime_metrics" },
        "producer": { "$ref": "#/$defs/producer" },
        "attempt_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  }
}
