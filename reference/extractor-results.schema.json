{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/instavar/instavar-voice-evaluation/main/reference/extractor-results.schema.json",
  "title": "Instavar Voice content-addressed extractor results",
  "type": "object",
  "required": ["schema_version", "source_observations_sha256", "extractor", "results"],
  "properties": {
    "schema_version": { "enum": ["1.1.0", "1.2.0", "1.3.0", "1.4.0", "1.5.0"] },
    "source_observations_sha256": { "$ref": "#/$defs/sha256" },
    "extractor": {
      "type": "object",
      "required": ["kind", "name", "revision", "artifact_set_sha256", "artifacts"],
      "properties": {
        "kind": { "enum": ["asr", "speaker_encoder", "audio_probe"] },
        "name": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "artifact_set_sha256": { "$ref": "#/$defs/sha256" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        }
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "required": ["reference_id", "audio", "transcript"],
      "properties": {
        "reference_id": { "$ref": "#/$defs/identifier" },
        "audio": { "$ref": "#/$defs/fileFingerprint" },
        "transcript": { "$ref": "#/$defs/fileFingerprint" }
      },
      "additionalProperties": false
    },
    "reference_catalog": {
      "type": "object",
      "required": ["catalog_id", "references", "catalog_sha256"],
      "properties": {
        "catalog_id": { "$ref": "#/$defs/identifier" },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["reference_id", "audio", "transcript"],
            "properties": {
              "reference_id": { "$ref": "#/$defs/identifier" },
              "audio": { "$ref": "#/$defs/fileFingerprint" },
              "transcript": { "$ref": "#/$defs/fileFingerprint" }
            },
            "additionalProperties": false
          }
        },
        "catalog_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "reference_aggregation": { "const": "mean_cosine_similarity_v1" },
    "reference_assignment_plan_sha256": { "$ref": "#/$defs/sha256" },
    "execution": {
      "oneOf": [
        { "$ref": "#/$defs/speechbrainExecution" },
        { "$ref": "#/$defs/fasterWhisperExecution" }
      ]
    },
    "execution_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sample_id", "audio_sha256", "status"],
        "properties": {
          "sample_id": { "$ref": "#/$defs/identifier" },
          "audio_sha256": { "$ref": "#/$defs/sha256" },
          "status": { "enum": ["complete", "failed"] },
          "values": { "type": "object" },
          "error_type": { "type": "string", "minLength": 1 },
          "error": { "type": "string", "minLength": 1 },
          "reference_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "complete" } } },
            "then": {
              "required": ["values"],
              "not": {
                "anyOf": [{ "required": ["error_type"] }, { "required": ["error"] }]
              }
            }
          },
          {
            "if": { "properties": { "status": { "const": "failed" } } },
            "then": {
              "required": ["error_type", "error"],
              "not": { "required": ["values"] }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "extractor": {
            "properties": { "kind": { "const": "speaker_encoder" } },
            "required": ["kind"]
          }
        },
        "required": ["extractor"]
      },
      "then": {
        "if": { "properties": { "schema_version": { "enum": ["1.2.0", "1.3.0", "1.4.0"] } } },
        "then": {
          "required": ["reference_catalog", "reference_aggregation"],
          "not": { "required": ["reference"] }
        },
        "else": {
          "required": ["reference"],
          "not": {
            "anyOf": [
              { "required": ["reference_catalog"] },
              { "required": ["reference_aggregation"] }
            ]
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["reference"] },
            { "required": ["reference_catalog"] },
            { "required": ["reference_aggregation"] },
            { "required": ["reference_assignment_plan_sha256"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": { "enum": ["1.2.0", "1.3.0", "1.4.0"] },
          "extractor": {
            "properties": { "kind": { "const": "speaker_encoder" } },
            "required": ["kind"]
          }
        },
        "required": ["schema_version", "extractor"]
      },
      "then": {
        "properties": {
          "results": {
            "items": { "required": ["reference_ids"] }
          }
        }
      },
      "else": {
        "properties": {
          "results": {
            "items": { "not": { "required": ["reference_ids"] } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": { "enum": ["1.3.0", "1.4.0"] },
          "extractor": {
            "properties": { "kind": { "const": "speaker_encoder" } },
            "required": ["kind"]
          }
        },
        "required": ["schema_version", "extractor"]
      },
      "then": { "required": ["reference_assignment_plan_sha256"] },
      "else": { "not": { "required": ["reference_assignment_plan_sha256"] } }
    },
    {
      "if": {
        "properties": { "schema_version": { "enum": ["1.4.0", "1.5.0"] } },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["execution", "execution_receipt_sha256"]
      },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["execution"] },
            { "required": ["execution_receipt_sha256"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "schema_version": { "const": "1.4.0" } },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "extractor": {
            "properties": { "kind": { "const": "speaker_encoder" } },
            "required": ["kind"]
          },
          "execution": { "$ref": "#/$defs/speechbrainExecution" }
        }
      }
    },
    {
      "if": {
        "properties": { "schema_version": { "const": "1.5.0" } },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "extractor": {
            "properties": { "kind": { "const": "asr" } },
            "required": ["kind"]
          },
          "execution": { "$ref": "#/$defs/fasterWhisperExecution" }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "speechbrainExecution": {
      "type": "object",
      "required": ["backend", "device", "trusted_model_checkpoints", "python_version", "platform", "package_versions"],
      "properties": {
        "backend": { "const": "instavar_voice_lab.speechbrain_ecapa_v1" },
        "device": { "type": "string", "pattern": "^(cpu|cuda(:[0-9]+)?)$" },
        "trusted_model_checkpoints": { "const": true },
        "python_version": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "package_versions": {
          "type": "object",
          "required": ["speechbrain", "torch", "torchaudio"],
          "properties": {
            "speechbrain": { "type": "string", "minLength": 1 },
            "torch": { "type": "string", "minLength": 1 },
            "torchaudio": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fasterWhisperExecution": {
      "type": "object",
      "required": [
        "backend",
        "device",
        "device_index",
        "compute_type",
        "python_version",
        "platform",
        "package_versions",
        "model_loading",
        "decoding"
      ],
      "properties": {
        "backend": { "const": "instavar_voice_lab.faster_whisper_v1" },
        "device": { "enum": ["cpu", "cuda"] },
        "device_index": { "type": "integer", "minimum": 0 },
        "compute_type": {
          "enum": ["auto", "default", "int8", "int8_bfloat16", "int8_float16", "int8_float32", "int16", "float16", "float32", "bfloat16"]
        },
        "python_version": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "package_versions": {
          "type": "object",
          "required": ["faster-whisper", "ctranslate2", "tokenizers", "av"],
          "properties": {
            "faster-whisper": { "type": "string", "minLength": 1 },
            "ctranslate2": { "type": "string", "minLength": 1 },
            "tokenizers": { "type": "string", "minLength": 1 },
            "av": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "model_loading": {
          "type": "object",
          "required": ["local_files_only"],
          "properties": { "local_files_only": { "const": true } },
          "additionalProperties": false
        },
        "decoding": {
          "type": "object",
          "required": [
            "language",
            "task",
            "beam_size",
            "temperature",
            "condition_on_previous_text",
            "word_timestamps",
            "vad_filter"
          ],
          "properties": {
            "language": { "type": "string", "pattern": "^[a-z]{2,3}$" },
            "task": { "const": "transcribe" },
            "beam_size": { "type": "integer", "minimum": 1 },
            "temperature": { "const": 0.0 },
            "condition_on_previous_text": { "const": false },
            "word_timestamps": { "const": false },
            "vad_filter": { "const": false }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": { "properties": { "device": { "const": "cpu" } }, "required": ["device"] },
          "then": { "properties": { "device_index": { "const": 0 } } }
        }
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["role", "kind", "sha256", "bytes"],
      "properties": {
        "role": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["file", "tree"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "file_count": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "tree" } } },
          "then": { "required": ["file_count"] },
          "else": { "not": { "required": ["file_count"] } }
        }
      ],
      "additionalProperties": false
    },
    "fileFingerprint": {
      "type": "object",
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
