{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instavar.com/schemas/resume-comparison-plan.schema.json",
  "title": "Instavar Voice resume artifact comparison plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "comparison_id",
    "required_artifact_roles",
    "interruption_receipt",
    "uninterrupted",
    "resumed"
  ],
  "properties": {
    "schema_version": { "enum": ["1.0.0", "1.1.0"] },
    "comparison_id": { "$ref": "#/$defs/identifier" },
    "required_artifact_roles": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "contains": { "const": "model_state" },
      "allOf": [
        { "contains": { "const": "optimizer_state" } },
        { "contains": { "const": "scheduler_state" } },
        { "contains": { "const": "trainer_state" } },
        { "contains": { "const": "rng_state" } }
      ],
      "items": { "$ref": "#/$defs/identifier" }
    },
    "interruption_receipt": { "$ref": "#/$defs/path" },
    "conditioning_artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "allOf": [
        { "contains": { "properties": { "role": { "const": "base_artifact" } }, "required": ["role"] } },
        { "contains": { "properties": { "role": { "const": "dataset_lineage" } }, "required": ["role"] } },
        { "contains": { "properties": { "role": { "const": "training_controls" } }, "required": ["role"] } },
        { "contains": { "properties": { "role": { "const": "initial_state" } }, "required": ["role"] } }
      ],
      "items": { "$ref": "#/$defs/artifact" }
    },
    "uninterrupted": { "$ref": "#/$defs/run" },
    "resumed": { "$ref": "#/$defs/run" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": "1.1.0" } },
        "required": ["schema_version"]
      },
      "then": { "required": ["conditioning_artifacts"] },
      "else": { "not": { "required": ["conditioning_artifacts"] } }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "path": { "type": "string", "minLength": 1 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "kind", "path"],
      "properties": {
        "role": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["file", "tree"] },
        "path": { "$ref": "#/$defs/path" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt", "artifacts"],
      "properties": {
        "receipt": { "$ref": "#/$defs/path" },
        "artifacts": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    }
  }
}
