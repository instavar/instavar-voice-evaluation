{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/instavar/instavar-voice-evaluation/main/reference/runtime-artifact-manifest.schema.json",
  "title": "Instavar Voice runtime artifact manifest",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_set_id",
    "producer",
    "source_artifact_set_sha256",
    "source_artifacts",
    "runtime_bindings",
    "evidence_boundary"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact_set_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "producer": {
      "type": "object",
      "required": ["repository", "revision"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      },
      "additionalProperties": false
    },
    "source_artifact_set_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_artifacts": { "$ref": "#/$defs/artifacts" },
    "runtime_bindings": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["runtime_id", "relation", "artifact_set_sha256", "artifacts"],
        "properties": {
          "runtime_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "relation": { "enum": ["exact", "derived"] },
          "artifact_set_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "artifacts": { "$ref": "#/$defs/artifacts" },
          "derived_from_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "conversion": {
            "type": "object",
            "required": ["tool", "revision"],
            "properties": {
              "tool": { "type": "string", "minLength": 1 },
              "revision": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_boundary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "kind", "sha256", "bytes"],
        "properties": {
          "role": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "kind": { "enum": ["file", "tree"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "file_count": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
