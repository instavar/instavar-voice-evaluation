{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/instavar/instavar-voice-evaluation/main/reference/speaker-reference-assignment-plan.schema.json",
  "title": "Instavar Voice frozen speaker reference assignment plan",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "generation_plan_sha256",
    "reference_catalog_sha256",
    "reference_aggregation",
    "selection_policy",
    "assignments",
    "assignment_plan_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "plan_id": { "$ref": "#/$defs/identifier" },
    "generation_plan_sha256": { "$ref": "#/$defs/sha256" },
    "reference_catalog_sha256": { "$ref": "#/$defs/sha256" },
    "reference_aggregation": { "const": "mean_cosine_similarity_v1" },
    "selection_policy": {
      "type": "object",
      "required": ["policy_id", "selection_stage", "stratification_dimensions", "rationale"],
      "properties": {
        "policy_id": { "$ref": "#/$defs/identifier" },
        "selection_stage": { "const": "before_candidate_generation_or_scoring" },
        "stratification_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["prompt_id", "seed", "reference_ids"],
        "properties": {
          "prompt_id": { "type": "string", "minLength": 1 },
          "seed": { "type": "integer", "minimum": 0 },
          "reference_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          }
        },
        "additionalProperties": false
      }
    },
    "assignment_plan_sha256": { "$ref": "#/$defs/sha256" }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
