{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/instavar/instavar-voice-evaluation/main/reference/capability-manifest.schema.json",
  "title": "Instavar Voice companion repository capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "model",
    "adaptation",
    "runtimes",
    "evaluation",
    "rights",
    "known_gaps"
  ],
  "properties": {
    "schema_version": { "enum": ["1.0.0", "1.1.0", "1.2.0"] },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "url", "evidence_revision"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
        "url": { "type": "string", "pattern": "^https://github.com/" },
        "evidence_revision": { "$ref": "#/$defs/gitSha" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "upstream_repository"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "upstream_repository": { "type": "string", "minLength": 1 }
      }
    },
    "adaptation": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "zero_shot": { "$ref": "#/$defs/capability" },
        "lora": { "$ref": "#/$defs/capability" },
        "full_sft": { "$ref": "#/$defs/capability" },
        "partial_sft": { "$ref": "#/$defs/capability" },
        "prompt_adapter": { "$ref": "#/$defs/capability" }
      }
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "artifact_mode", "streaming", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "$ref": "#/$defs/capabilityStatus" },
          "artifact_mode": {
            "enum": ["base", "adapter", "merged", "checkpoint"]
          },
          "streaming": { "type": "boolean" },
          "evidence": { "$ref": "#/$defs/evidence" },
          "notes": { "type": "string" },
          "profile": { "$ref": "#/$defs/runtimeProfile" },
          "device": { "type": "string", "minLength": 1 },
          "interface": { "$ref": "#/$defs/runtimeInterface" },
          "precision": { "type": "string", "minLength": 1 },
          "batching": { "type": "boolean" },
          "conformance": { "$ref": "#/$defs/runtimeConformance" }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_pack", "objective_metrics", "listening_criteria"],
      "properties": {
        "prompt_pack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "sha256"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "objective_metrics": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "listening_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "matched_comparison": { "$ref": "#/$defs/matchedComparison" }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "weights", "dataset", "generated_output"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "weights": { "type": "string", "minLength": 1 },
        "dataset": { "type": "string", "minLength": 1 },
        "generated_output": { "type": "string", "minLength": 1 }
      }
    },
    "known_gaps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "enum": ["1.1.0", "1.2.0"] } },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "runtimes": {
            "items": {
              "required": [
                "id",
                "status",
                "artifact_mode",
                "streaming",
                "evidence",
                "profile",
                "device",
                "interface",
                "precision",
                "batching",
                "conformance"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "schema_version": { "const": "1.2.0" } },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "evaluation": { "required": ["prompt_pack", "objective_metrics", "listening_criteria", "matched_comparison"] }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "capabilityStatus": {
      "enum": [
        "supported",
        "experimental",
        "upstream_only",
        "unverified_for_adapter",
        "unsupported"
      ]
    },
    "runtimeProfile": {
      "enum": ["reference", "optimized_cuda", "apple_silicon", "cpu_edge", "server", "experimental"]
    },
    "runtimeInterface": {
      "enum": ["python", "cli", "http", "grpc"]
    },
    "runtimeConformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "clean_checkout", "fresh_process", "prompt_count", "seed_count"],
      "properties": {
        "status": { "enum": ["not_run", "smoke_tested", "validated", "negative_result"] },
        "clean_checkout": { "type": "boolean" },
        "fresh_process": { "type": "boolean" },
        "prompt_count": { "type": "integer", "minimum": 0 },
        "seed_count": { "type": "integer", "minimum": 0 },
        "report": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceLevel": {
      "enum": [
        "repository_declared",
        "upstream_benchmark",
        "smoke_tested",
        "validated",
        "promoted",
        "negative_result"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "ref", "claim"],
        "properties": {
          "level": { "$ref": "#/$defs/evidenceLevel" },
          "ref": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 }
        }
      }
    },
    "lifecycleStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "boundary"],
      "properties": {
        "status": {
          "enum": [
            "not_recorded",
            "repository_declared",
            "smoke_tested",
            "validated",
            "negative_result",
            "blocked"
          ]
        },
        "evidence": { "$ref": "#/$defs/evidence" },
        "boundary": { "type": "string", "minLength": 1 }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_audit",
        "training",
        "checkpoint_save",
        "fresh_process_reload",
        "held_out_inference",
        "evaluation",
        "packaging"
      ],
      "properties": {
        "corpus_audit": { "$ref": "#/$defs/lifecycleStage" },
        "training": { "$ref": "#/$defs/lifecycleStage" },
        "checkpoint_save": { "$ref": "#/$defs/lifecycleStage" },
        "fresh_process_reload": { "$ref": "#/$defs/lifecycleStage" },
        "held_out_inference": { "$ref": "#/$defs/lifecycleStage" },
        "evaluation": { "$ref": "#/$defs/lifecycleStage" },
        "packaging": { "$ref": "#/$defs/lifecycleStage" }
      }
    },
    "matchedComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "baseline_candidate", "adapted_candidate", "blockers"],
      "properties": {
        "status": { "enum": ["not_run", "partial", "complete", "blocked"] },
        "baseline_candidate": { "type": "string", "minLength": 1 },
        "adapted_candidate": { "type": "string", "minLength": 1 },
        "report": { "type": "string", "minLength": 1 },
        "blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "$ref": "#/$defs/capabilityStatus" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "notes": { "type": "string" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" }
      }
    }
  }
}
