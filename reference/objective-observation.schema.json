{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/instavar/instavar-voice-evaluation/main/reference/objective-observation.schema.json",
  "title": "Instavar Voice objective observation array",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "observation_schema_version",
      "sample_id",
      "candidate_id",
      "prompt_id",
      "seed",
      "requested_text",
      "valid",
      "runtime_id"
    ],
    "properties": {
      "observation_schema_version": { "const": "1.0.0" },
      "sample_id": { "$ref": "#/$defs/identifier" },
      "candidate_id": { "$ref": "#/$defs/identifier" },
      "prompt_id": { "$ref": "#/$defs/identifier" },
      "seed": { "type": "integer", "minimum": 0 },
      "requested_text": { "type": "string", "minLength": 1 },
      "valid": { "type": "boolean" },
      "runtime_id": { "$ref": "#/$defs/identifier" },
      "artifact_set_id": { "$ref": "#/$defs/identifier" },
      "artifact_set_sha256": { "$ref": "#/$defs/sha256" },
      "hypothesis_text": { "type": "string" },
      "reference_speaker_embedding": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "number" }
      },
      "speaker_embedding": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "number" }
      },
      "generation_seconds": { "type": "number", "minimum": 0 },
      "audio_duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
      "peak_memory_bytes": { "type": "number", "minimum": 0 },
      "evidence": { "type": "object" }
    },
    "dependentRequired": {
      "artifact_set_id": ["artifact_set_sha256"],
      "artifact_set_sha256": ["artifact_set_id"]
    },
    "additionalProperties": true
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
