{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/instavar/instavar-voice-evaluation/main/reference/objective-observation.schema.json",
  "title": "Instavar Voice objective observation array",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "observation_schema_version",
      "sample_id",
      "candidate_id",
      "prompt_id",
      "seed",
      "requested_text",
      "valid",
      "runtime_id"
    ],
    "properties": {
      "observation_schema_version": { "const": "1.0.0" },
      "sample_id": { "$ref": "#/$defs/identifier" },
      "candidate_id": { "$ref": "#/$defs/identifier" },
      "prompt_id": { "$ref": "#/$defs/identifier" },
      "seed": { "type": "integer", "minimum": 0 },
      "requested_text": { "type": "string", "minLength": 1 },
      "valid": { "type": "boolean" },
      "runtime_id": { "$ref": "#/$defs/identifier" },
      "artifact_set_id": { "$ref": "#/$defs/identifier" },
      "artifact_set_sha256": { "$ref": "#/$defs/sha256" },
      "hypothesis_text": { "type": "string" },
      "reference_speaker_embedding": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "number" }
      },
      "reference_speaker_embeddings": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["reference_id", "embedding"],
          "properties": {
            "reference_id": { "$ref": "#/$defs/identifier" },
            "embedding": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "number" }
            }
          },
          "additionalProperties": false
        }
      },
      "speaker_embedding": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "number" }
      },
      "generation_seconds": { "type": "number", "minimum": 0 },
      "audio_duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
      "peak_memory_bytes": { "type": "number", "minimum": 0 },
      "sample_rate_hz": { "type": "integer", "minimum": 1 },
      "silence_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
      "clipping_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
      "prosody_analysis_duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
      "prosody_eligible_for_long_form": { "type": "boolean" },
      "prosody_active_frame_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
      "prosody_active_rms_db_std": { "type": ["number", "null"], "minimum": 0 },
      "prosody_window_rms_db_std": { "type": ["number", "null"], "minimum": 0 },
      "prosody_zero_crossing_rate_hz_std": { "type": ["number", "null"], "minimum": 0 },
      "prosody_pause_rate_per_minute": { "type": "number", "minimum": 0 },
      "prosody_pause_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
      "prosody_pause_duration_cv": { "type": ["number", "null"], "minimum": 0 },
      "prosody_phrase_duration_cv": { "type": ["number", "null"], "minimum": 0 },
      "prosody_leading_inactive_seconds": { "type": "number", "minimum": 0 },
      "prosody_trailing_inactive_seconds": { "type": "number", "minimum": 0 },
      "evidence": { "type": "object" }
    },
    "dependentRequired": {
      "artifact_set_id": ["artifact_set_sha256"],
      "artifact_set_sha256": ["artifact_set_id"]
    },
    "additionalProperties": true
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
